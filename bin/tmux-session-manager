#!/usr/bin/env bash
# アイコン選択関数
select_icon() {
  selected=$(cat <<'EOF' | fzf --prompt="Icon: " --preview-window=hidden
󰣆 : default
󰈙 : code
 : terminal
󰋜 : home
󱁤 : folder
󰈔 : config
󰏗 : package
󰃤 : bug
󰆼 : db
󰓹 : tag
󰉋 : docs
󰷐 : server
󰒓 : settings
󰣀 : cloud
󱄅 : nix
󰇮 : mail
󰌆 : key
󰖟 : web
󰊤 : github
 : vscode
󰅩 : edit
󰃀 : bookmark
󰋚 : history
 : git
󰙱 : docker
󱗆 : bird
󰇥 : duck
󰐟 : poll
 : neovim
 : lua
 : cpp
 : typescript
 : rust
 : python
󰔧 : tool
󰙅 : tree
󰖙 : sun
󰐃 : pin
󰯂 : script
󰈐 : fan
󰆐 : cut
󰏏 : paw
󰏫 : pen
󰆓 : save
󰐦 : plug
󰌪 : leaf
󰩹 : gift
󰈺 : fish
󰂡 : bone
󰖝 : wind
󰕙 : tint
 : emacs
 : java
󰟓 : go
 : react
 : ruby
󱃾 : kubernetes
󰑣 : rocket
󰅶 : coffee
󰓎 : star
󰈸 : fire
󰚩 : robot
󰝚 : music
󰃭 : calendar
󰋑 : heart
󰌾 : lock
󱐋 : lightning
󰭹 : chat
󰘚 : chip
󰍹 : monitor
󰐥 : power
󰓅 : speedometer
 : brain
󰍉 : search
 : flask
 : bulb
 : book
󰓾 : target
 : flag
 : bell
 : trophy
 : hammer
 : wrench
 : pencil
EOF
)
  if [ -n "$selected" ]; then
    echo "$selected" | awk '{print $1}'
  else
    echo ""
  fi
}

# セッション一覧を整形してソート
sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | while read -r s; do
  if [ "$(echo "$s" | cut -c2)" = " " ]; then
    echo "$(echo "$s" | cut -c3-)|$s"
  else
    echo "$s|$s"
  fi
done | sort | cut -d'|' -f2)

# tmuxセッション一覧をfzfで表示し、アクションを実行
result=$(echo "$sessions" | \
  fzf --prompt="Session: " \
      --preview='tmux list-windows -t {} -F "#{window_index}: #{window_name}"' \
      --preview-window=right:20% \
      --expect=ctrl-q,ctrl-t,ctrl-r \
      --no-select-1 \
      --header='Enter: switch | ^Q: kill | ^T: new | ^R: rename')

# fzfがキャンセルされた場合は終了
if [ -z "$result" ]; then
  exit 0
fi

# 結果を解析（1行目がキー、2行目が選択されたセッション名）
key=$(echo "$result" | sed -n '1p')
session=$(echo "$result" | sed -n '2p')

# アクションに応じて処理
case "$key" in
  ctrl-q)
    if [ -n "$session" ]; then
      echo -n "Kill session '$session'? (y/N): "
      read -r answer
      if [ "$answer" = "y" ] || [ "$answer" = "Y" ]; then
        current_session=$(tmux display-message -p '#S')
        if [ "$session" = "$current_session" ]; then
          tmux switch-client -n
        fi
        tmux kill-session -t "$session"
        echo "Session '$session' killed."
      else
        echo "Cancelled."
      fi
    fi
    ;;

  ctrl-t)
    echo -n "New session name: "
    read -r new_session
    if [ -n "$new_session" ]; then
      icon=$(select_icon)
      full_session_name="$icon $new_session"
      tmux new-session -d -s "$full_session_name"
      tmux switch-client -t "$full_session_name"
      echo "Session '$full_session_name' created."
    else
      echo "Cancelled."
    fi
    ;;

  ctrl-r)
    if [ -n "$session" ]; then
      echo -n "New name for '$session': "
      read -r new_name
      if [ -n "$new_name" ]; then
        icon=$(select_icon)
        full_session_name="$icon $new_name"
        tmux rename-session -t "$session" "$full_session_name"
        echo "Session renamed to '$full_session_name'."
      else
        echo "Cancelled."
      fi
    fi
    ;;

  *)
    if [ -n "$session" ]; then
      tmux switch-client -t "$session"
    fi
    ;;
esac
